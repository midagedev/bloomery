+// bloomery's DSpark oracle dump (tools/ref/dump-ml4-dspark.sh): under LLAMA_DSPARK_DUMP=<dir>, the
+// rows the draft is fed (taps.f32, positions in taps.pos) and each draft call (calls.tsv).
+static FILE * dspark_dump_open(const char * name, const char * mode) {
+    const char * dir = getenv("LLAMA_DSPARK_DUMP");
+    if (!dir || !*dir) {
+        return nullptr;
+    }
+    const std::string path = std::string(dir) + "/" + name;
+    FILE * f = fopen(path.c_str(), mode);
+    if (!f) {
+        GGML_ABORT("LLAMA_DSPARK_DUMP: cannot open %s", path.c_str());
+    }
+    return f;
+}
