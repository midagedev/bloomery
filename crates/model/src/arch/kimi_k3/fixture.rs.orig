//! The Kimi K3 (`kimi-k3`) gate fixture's spec ([`spec`]): the facts of a `kimi-k3` file the common
//! generator (`crate::fixture`) cannot know. The model is 93 layers of two mixers — Kimi delta
//! attention and a gated latent attention every fourth layer — over a dense lead and routed
//! `situ` experts that run in a latent, with the cross-layer residual's scores beside every
//! sublayer, and the file is a split set whose first shard holds the metadata alone.
//!
//! The fixture is a requantized mini-K3 of four real layers, renamed `blk.L.` → `blk.f.`:
//!
//! | fixture layer | source layer | what it is |
//! |---|---|---|
//! | f0 | L0 | a delta layer with the dense lead; a bank (`l % block == 0`) |
//! | f1 | L46 | a routed delta layer, IQ2_XXS gate and up stacks and an IQ1_S down stack |
//! | f2 | L83 | a routed latent layer, IQ1_S gate and up stacks and an IQ2_XXS down stack; a bank |
//! | f3 | L84 | a routed delta layer after a latent one, IQ1_S on all three stacks |
//!
//! The kinds are the real file's at the real indexes' pattern (delta, delta, latent, delta), the
//! cross-layer residual banks at f0 and f2 (`attn_res.block_size` 2, so a mix reads a non-empty
//! bank from f1 on), and every (stem, type) pair of the real file's routed stacks is held: the
//! three stacks' IQ1_S and IQ2_XXS in both roles. The map is read from the source's own
//! `attention.head_count_kv` and tensor types, layer by layer ([`KINDS`]), never reconstructed
//! from a rule.
//!
//! What it keeps, because the card kernels are built for it: the delta head width 128 with the
//! conv's 4 taps, the latent attention's kv latent 512, rope width 64, head 192 (128 + 64) and
//! value 128, the router's sigmoid and renormalization, the shared stack of two experts, the
//! `situ` bounds, the real vocabulary (the globals keep their second axis and the tokenizer
//! tables are the source's copied ones, so the fixture's tokenizer is the file's) and every
//! tensor's type.
//!
//! What it minifies: the hidden (512), the head count (2: a delta state of 2 × 128 × 128), the
//! query latent (256), the dense lead's width (1024), the routed experts (8, 2 used) and their
//! width (256), the experts' latent (256) and the bank interval (2). Every first dim is a whole
//! block of every type its tensor holds. The shapes are the reader's own: the dims of each
//! source tensor are what the reader asks of a file of the mini's keys at the source layer's kind
//! (`Hparams::layer_dims`), so a stem the reader reads and the fixture has no table for cannot
//! exist, and the file the plan writes reads back through the reader's own dims and type checks.
//!
//! The fills (the generator's matrix rule is σ 1/√K, so a projection of a unit-RMS input has unit
//! RMS): the norm gains are 1; the decay's `ssm_a` and `ssm_dt.bias` are constants
//! ([`SSM_A`], [`SSM_DT_BIAS`]); the router's selection bias and the three residual score vectors
//! are spreads ([`BIAS_HALF_WIDTH`], [`SCORE_HALF_WIDTH`]), per element, so a body that
//! broadcasts one value or skips one fails and the mix's softmax is not uniform.
//!
//! The card budget is fixed, not planned: the architecture has no program yet, so no plan of the
//! written file chooses a cap; the recorded 2 GiB keeps the whole fixture resident. No draft file
//! and no r8 sidecar.

use gguf::{GgmlType, Split};

use super::hparams::{Hparams, Kind, Mla};
use super::names::OUTPUT_RES_SCORE;
use crate::arch::names::{blk, output, output_norm, token_embd};
use crate::arch::noaux::Experts;
use crate::fixture::{CardBudget, Family, FixtureError, FixtureSpec, KeyRule, Tables, Window};

/// Fixture layer `f` holds source layer `LAYER_MAP[f]` (the table above).
pub const LAYER_MAP: [usize; 4] = [0, 46, 83, 84];

/// The hidden the mini writes: `embedding_length`, the residual stream and the router's row.
pub const HIDDEN: u64 = 512;
/// The heads the mini writes: the latent layer's query heads and the delta layers' key and value
/// heads. The delta head's width stays the real file's 128.
pub const HEADS: u64 = 2;
/// The routed experts the mini writes: `expert_count`.
pub const EXPERTS: u64 = 8;
/// The experts one token uses: `expert_used_count`.
pub const USED: u64 = 2;
/// One routed expert's width the mini writes: `expert_feed_forward_length`, which the shared
/// stack's (`expert_shared_count` of them) shares.
pub const FF: u64 = 256;
/// The width the routed experts run in the mini: `expert_latent_length`. It is half of [`HIDDEN`],
/// so a body that mixes the two up reads other dims, and the reader's checks refuse the file.
pub const LATENT: u64 = 256;
/// The dense lead's width the mini writes: `feed_forward_length`.
pub const DENSE_FF: u64 = 1024;
/// The latent layer's query latent the mini writes: `attention.q_lora_rank`.
pub const Q_LORA: u64 = 256;
/// The bank interval the mini writes: `attn_res.block_size`.
pub const BLOCK: u64 = 2;

/// The d window, [2^-14, 2^-4]: normal f16 values every type's scale fits at every K the mini
/// holds (K from 128 to 1,024).
pub const D_MIN: f32 = 1.0 / 16384.0;
/// See [`D_MIN`].
pub const D_MAX: f32 = 1.0 / 16.0;

/// The most tensor data a shard holds: the shared default, above the fixture's tensor data, so
/// the fixture is one shard.
pub const SHARD_BYTES: u64 = crate::fixture::DEFAULT_SHARD_BYTES;

/// The card byte budget the fixture records. Above the fixture's tensor data, it keeps the whole
/// model resident; the architecture has no program to plan a cap through.
pub const CARD_BUDGET: u64 = 2 << 30;

/// The target file is `<STEM>-00001-of-00001.gguf`.
pub const STEM: &str = "kimi-k3-fixture";

/// The real first shard `verify` opens when none is named: the profile's file.
pub const DEFAULT_MODEL: &str = "/models/Kimi-K3-UD-IQ1_S/Kimi-K3-UD-IQ1_S-00001-of-00014.gguf";

const ARCH: &str = "kimi-k3";

/// The `ssm_a` constant: the decay `lb · sigmoid(-A · (f_b f_a x + dt))` sits near its bound for
/// a small input and stays in [lb, 0] for any finite value. The fill is a fixture's, not a
/// measurement of the real file.
const SSM_A: f32 = -5.0;
/// The `ssm_dt.bias` constant, a fixture's, not a measurement of the real file.
const SSM_DT_BIAS: f32 = -1.0;

/// The half-width of the router's selection bias (`exp_probs_b.bias`), drawn per expert: wide
/// enough that it steers the pick, narrow enough that the sigmoid scores still decide it.
pub const BIAS_HALF_WIDTH: f32 = 0.05;

/// The half-width of the three residual score vectors (`attn_res_score`, `ffn_res_score`,
/// `output_res_score`), drawn per element: the mix's scores are the row's RMS-normed values
/// against the vector summed over the row, so a unit-RMS row against ±0.1 scores of order one
/// differing by bank, not all equal.
pub const SCORE_HALF_WIDTH: f32 = 0.1;

/// What a source layer must read as for the map to keep a fixture layer's kind: the rows of the
/// table above.
struct Layer {
    /// The layer mixes with the delta rule, not the latent attention.
    kda: bool,
    /// The layer is the dense lead.
    dense: bool,
    /// The type of the routed gate and up stacks; `None` for a dense layer.
    gate_up: Option<GgmlType>,
    /// The type of the routed down stack; `None` for a dense layer.
    down: Option<GgmlType>,
}

/// The four kinds of [`LAYER_MAP`], layer by layer.
const KINDS: [Layer; 4] = [
    Layer {
        kda: true,
        dense: true,
        gate_up: None,
        down: None,
    },
    Layer {
        kda: true,
        dense: false,
        gate_up: Some(GgmlType::IQ2_XXS),
        down: Some(GgmlType::IQ1_S),
    },
    Layer {
        kda: false,
        dense: false,
        gate_up: Some(GgmlType::IQ1_S),
        down: Some(GgmlType::IQ2_XXS),
    },
    Layer {
        kda: true,
        dense: false,
        gate_up: Some(GgmlType::IQ1_S),
        down: Some(GgmlType::IQ1_S),
    },
];

/// The Kimi K3 fixture: [`LAYER_MAP`], the window [[`D_MIN`], [`D_MAX`]], the profile's file as the
/// default source, no ff override (the mini's expert width is a header key, not an ff axis), no
/// draft and a fixed card budget.
pub fn spec() -> FixtureSpec {
    FixtureSpec {
        arch: ARCH,
        stem: STEM,
        layers: LAYER_MAP.to_vec(),
        ratios: Vec::new(),
        card_budget: CardBudget::Fixed(CARD_BUDGET),
        window: Window::new(D_MIN, D_MAX).expect("[2^-14, 2^-4] is inside the normal f16 values"),
        ff: None,
        shard_bytes: SHARD_BYTES,
        default_source,
        draft: None,
        sidecar: None,
        family: &Mini,
    }
}

fn default_source() -> String {
    DEFAULT_MODEL.to_string()
}

/// The coverage table of the architecture keys; `None` is a key the map does not cover. What the
/// mini resizes is a [`KeyRule::Set`]; the per-layer head counts follow the map; the rest — the
/// epsilons, the latent, rope and head widths, the delta head and decay bound, the router's
/// constants, the dense-block count, the `situ` bounds and the vocabulary — is copied. The file's
/// stale `attention.value_length` and its `rope.freq_base` are copied too: the reader lists them
/// unread.
pub fn key_rule(suffix: &str) -> Option<KeyRule> {
    const COPY: &[&str] = &[
        "context_length",
        "vocab_size",
        "rope.freq_base",
        "attention.layer_norm_rms_epsilon",
        "attention.key_length",
        "attention.value_length",
        "attention.key_length_mla",
        "attention.value_length_mla",
        "attention.kv_lora_rank",
        "rope.dimension_count",
        "ssm.conv_kernel",
        "kda.head_dim",
        "kda.gate_lower_bound",
        "leading_dense_block_count",
        "expert_group_used_count",
        "expert_gating_func",
        "expert_shared_count",
        "expert_weights_scale",
        "expert_weights_norm",
        "activation.situ_beta",
        "activation.situ_linear_beta",
    ];
    Some(match suffix {
        "block_count" => KeyRule::BlockCount,
        "attention.head_count_kv" => KeyRule::PerLayer,
        "embedding_length" => KeyRule::Set(HIDDEN),
        "feed_forward_length" => KeyRule::Set(DENSE_FF),
        "attention.head_count" => KeyRule::Set(HEADS),
        "expert_count" => KeyRule::Set(EXPERTS),
        "expert_used_count" => KeyRule::Set(USED),
        "expert_feed_forward_length" => KeyRule::Set(FF),
        "expert_latent_length" => KeyRule::Copy,
        "attention.q_lora_rank" => KeyRule::Set(Q_LORA),
        "attn_res.block_size" => KeyRule::Set(BLOCK),
        s if COPY.contains(&s) => KeyRule::Copy,
        _ => return None,
    })
}

/// The value of a 1-D F32 tensor the family names, by its name past `blk.N.`: the norm gains 1
/// and the decay's `ssm_a` and `ssm_dt.bias` ([`SSM_A`], [`SSM_DT_BIAS`]). The selection bias and
/// the residual scores are spreads ([`spread_value`]).
pub fn const_value(leaf: &str) -> Option<f32> {
    const RULES: [(&str, f32); 9] = [
        ("attn_norm.weight", 1.0),
        ("ffn_norm.weight", 1.0),
        ("attn_q_a_norm.weight", 1.0),
        ("attn_kv_a_norm.weight", 1.0),
        ("ssm_norm.weight", 1.0),
        ("ffn_routed_norm.weight", 1.0),
        ("output_norm.weight", 1.0),
        ("ssm_a", SSM_A),
        ("ssm_dt.bias", SSM_DT_BIAS),
    ];
    RULES.iter().find(|(n, _)| *n == leaf).map(|&(_, v)| v)
}

/// The spread of an F32 tensor the family names: the router's selection bias
/// ([`BIAS_HALF_WIDTH`]) and the three residual score vectors ([`SCORE_HALF_WIDTH`]).
pub fn spread_value(leaf: &str) -> Option<f32> {
    match leaf {
        "exp_probs_b.bias" => Some(BIAS_HALF_WIDTH),
        "attn_res_score.weight" | "ffn_res_score.weight" | OUTPUT_RES_SCORE => {
            Some(SCORE_HALF_WIDTH)
        }
        _ => None,
    }
}

/// The map's layers must read as [`KINDS`] in `src`, layer by layer from the source's own
/// array and tensor types, and the dense lead must be the first of them alone. A source that
/// differs is refused by name, so a rule of the model that moved cannot hide behind a map that
/// still has the right layer numbers.
fn check_map(src: &Hparams, source: &Split, layers: &[usize]) -> Result<(), FixtureError> {
    if layers.len() != KINDS.len() {
        return Err(FixtureError::Mismatch {
            what: "the layer map".into(),
            detail: format!(
                "holds {} layers, the fixture is built for the {} of the kinds above",
                layers.len(),
                KINDS.len()
            ),
        });
    }
    for (f, (&l, kind)) in layers.iter().zip(&KINDS).enumerate() {
        if l >= src.n_layer {
            return Err(FixtureError::NoSourceLayer {
                layer: l,
                n_layer: src.n_layer,
            });
        }
        let bad = |got: String, want: String| FixtureError::Mismatch {
            what: "the layer map".into(),
            detail: format!("source layer {l} (fixture {f}) {got}, the kind keeps it {want}"),
        };
        let mixer = |kda: bool| {
            if kda {
                "a delta layer"
            } else {
                "a latent layer"
            }
        };
        let is_kda = src.kind(l) == Kind::Kda;
        if is_kda != kind.kda {
            return Err(bad(format!("is {}", mixer(is_kda)), mixer(kind.kda).into()));
        }
        let ffn = |dense: bool| if dense { "dense" } else { "routed" };
        if src.dense(l) != kind.dense {
            return Err(bad(
                format!("is {}", ffn(src.dense(l))),
                ffn(kind.dense).into(),
            ));
        }
        for (stem, want) in [
            ("ffn_gate_exps.weight", kind.gate_up),
            ("ffn_up_exps.weight", kind.gate_up),
            ("ffn_down_exps.weight", kind.down),
        ] {
            let got = source.find(&blk(l, stem)).map(|(_, t)| t.ty);
            if got != want {
                return Err(bad(
                    format!("holds {stem} as {got:?}"),
                    format!("as {want:?}"),
                ));
            }
        }
    }
    Ok(())
}

/// The hyperparameters of the source with the mini's widths, its layers still the source's own
/// numbers: what `Hparams::layer_dims` answers a source layer with in the fixture's dims.
fn resized(src: &Hparams) -> Hparams {
    Hparams {
        n_embd: HIDDEN as usize,
        n_head: HEADS as usize,
        latent: LATENT as usize,
        dense_ff: DENSE_FF as usize,
        attn_res_block: BLOCK as usize,
        mla: Mla {
            q_lora: Q_LORA as usize,
            ..src.mla
        },
        experts: Experts {
            n_expert: EXPERTS as usize,
            n_used: USED as usize,
            ff: FF as usize,
            shared_width: src.experts.n_shared * FF as usize,
            ..src.experts
        },
        ..src.clone()
    }
}

/// The hyperparameters the fixture must read as: [`resized`] and the per-layer kinds at the
/// map's layers.
fn cut_of(src: &Hparams, layers: &[usize]) -> Hparams {
    Hparams {
        n_layer: layers.len(),
        kinds: layers.iter().map(|&l| src.kinds[l]).collect(),
        ..resized(src)
    }
}

/// The mini geometry the plan writes every tensor at: [`resized`] of the source, asked layer by
/// layer. A name the reader does not hold is refused: every tensor of a file the reader accepts
/// is one of its stems, so the refusal names one the reader has not met.
struct Mini;

/// The tables of one plan: the source's hyperparameters at the mini's widths.
struct MiniTables(Hparams);

impl Tables for MiniTables {
    fn dims(
        &self,
        name: &str,
        layer: Option<usize>,
        leaf: &str,
        dims: &[u64],
    ) -> Result<Option<Vec<u64>>, FixtureError> {
        let bad = |detail: String| FixtureError::Tensor {
            name: name.to_string(),
            detail,
        };
        if let Some(l) = layer {
            return self
                .0
                .layer_dims(l)
                .into_iter()
                .find(|(stem, _)| *stem == leaf)
                .map(|(_, d)| Some(d))
                .ok_or_else(|| {
                    bad("is no tensor of the mini table: the reader names every tensor of a kimi-k3 layer of this kind, so this one is new".into())
                });
        }
        if name == token_embd() || name == output() {
            let [_, vocab] = dims else {
                return Err(bad(format!(
                    "has dims {dims:?}; the globals are the hidden over the vocabulary"
                )));
            };
            return Ok(Some(vec![HIDDEN, *vocab]));
        }
        if name == output_norm() || name == OUTPUT_RES_SCORE {
            return Ok(Some(vec![HIDDEN]));
        }
        Err(bad(
            "is no tensor of the mini table: the reader names every tensor outside the layers of a kimi-k3 file, so this one is new".into(),
        ))
    }

    fn lines(&self) -> Vec<String> {
        vec![format!(
            "kimi-k3 mini: hidden {HIDDEN}, {HEADS} heads of {} (delta state {HEADS} x {} x {}), \
             latent attention {} + {} rope, query latent {Q_LORA}, {EXPERTS} experts of width {FF} \
             in a latent of {LATENT}, dense lead {DENSE_FF}, a bank every {BLOCK} layers, the real \
             vocabulary",
            self.0.kda.head_dim,
            self.0.kda.head_dim,
            self.0.kda.head_dim,
            self.0.mla.kv_lora,
            self.0.mla.pe
        )]
    }
}

impl Family for Mini {
    fn key_rule(&self, suffix: &str) -> Option<KeyRule> {
        key_rule(suffix)
    }

    fn const_value(&self, leaf: &str) -> Option<f32> {
        const_value(leaf)
    }

    fn spread_value(&self, leaf: &str) -> Option<f32> {
        spread_value(leaf)
    }

    /// Every key a [`KeyRule::Set`] rewrites, which the plan only walks if the source has it.
    fn required_keys(&self) -> &'static [&'static str] {
        &[
            "embedding_length",
            "feed_forward_length",
            "attention.head_count",
            "expert_count",
            "expert_used_count",
            "expert_feed_forward_length",
            "expert_latent_length",
            "attention.q_lora_rank",
            "attn_res.block_size",
        ]
    }

    /// The source must read as a `kimi-k3` file whose map layers are the kinds of [`KINDS`];
    /// every dim of the mini is the reader's own for the source layer's kind.
    fn tables(&self, source: &Split, spec: &FixtureSpec) -> Result<Box<dyn Tables>, FixtureError> {
        let src = Hparams::read(source)?;
        check_map(&src, source, &spec.layers)?;
        Ok(Box::new(MiniTables(resized(&src))))
    }

    fn check_kinds(
        &self,
        spec: &FixtureSpec,
        fixture: &Split,
        source: &Split,
    ) -> Result<(), FixtureError> {
        check_kinds(spec, fixture, source).map(|_| ())
    }
}

/// `got` is `want`, or the mismatch of `key`.
fn same<T: PartialEq + std::fmt::Debug>(key: &str, got: &T, want: &T) -> Result<(), FixtureError> {
    if got == want {
        Ok(())
    } else {
        Err(FixtureError::Mismatch {
            what: key.to_string(),
            detail: format!("{got:?}, the cut's {want:?}"),
        })
    }
}

/// The engine reads `fixture`'s header as a `kimi-k3` file of the map's four layers whose kinds
/// are the source layers', at the mini's hidden, head count, experts, latent, dense width, query
/// latent and bank interval, with the source's latent, rope, head, delta, router, `situ`, epsilon
/// and vocabulary facts, and every mapped tensor's type the source layer's — the (stem, type)
/// pairs of the real file. Tensor names and dims are the plan's, which `verify` holds the file
/// to, and which the reader's own dims and type checks held the header to already.
pub fn check_kinds(
    spec: &FixtureSpec,
    fixture: &Split,
    source: &Split,
) -> Result<Hparams, FixtureError> {
    let fx = Hparams::read(fixture)?;
    let src = Hparams::read(source)?;
    check_map(&src, source, &spec.layers)?;
    let cut = cut_of(&src, &spec.layers);
    same("block_count", &fx.n_layer, &cut.n_layer)?;
    same("attention.head_count_kv", &fx.kinds, &cut.kinds)?;
    same("embedding_length", &fx.n_embd, &cut.n_embd)?;
    same("attention.head_count", &fx.n_head, &cut.n_head)?;
    same("expert_count", &fx.experts.n_expert, &cut.experts.n_expert)?;
    same("expert_used_count", &fx.experts.n_used, &cut.experts.n_used)?;
    same(
        "expert_feed_forward_length",
        &fx.experts.ff,
        &cut.experts.ff,
    )?;
    same("expert_latent_length", &fx.latent, &cut.latent)?;
    same("feed_forward_length", &fx.dense_ff, &cut.dense_ff)?;
    same("attention.q_lora_rank", &fx.mla.q_lora, &cut.mla.q_lora)?;
    same(
        "attn_res.block_size",
        &fx.attn_res_block,
        &cut.attn_res_block,
    )?;
    same("leading_dense_block_count", &fx.dense_lead, &cut.dense_lead)?;
    same("context_length", &fx.n_ctx_train, &cut.n_ctx_train)?;
    same("vocab_size", &fx.n_vocab, &cut.n_vocab)?;
    same("kda.head_dim", &fx.kda, &cut.kda)?;
    same("kda.gate_lower_bound", &fx.gate, &cut.gate)?;
    same("attention.kv_lora_rank", &fx.mla.kv_lora, &cut.mla.kv_lora)?;
    same("the latent attention's widths", &fx.mla, &cut.mla)?;
    same("activation.situ", &fx.situ, &cut.situ)?;
    same(
        "attention.layer_norm_rms_epsilon",
        &fx.rms_eps,
        &cut.rms_eps,
    )?;
    same("the router's keys", &fx.experts, &cut.experts)?;
    same("the keys read by default", &fx.defaults, &cut.defaults)?;
    same("the hyperparameters", &fx, &cut)?;
    for (f, &l) in spec.layers.iter().enumerate() {
        for (stem, _) in cut.layer_dims(f) {
            let (Some((_, a)), Some((_, b))) =
                (fixture.find(&blk(f, stem)), source.find(&blk(l, stem)))
            else {
                return Err(FixtureError::Mismatch {
                    what: format!("layer {f} (source {l})"),
                    detail: format!("{stem} is missing from the fixture or the source"),
                });
            };
            if a.ty != b.ty {
                return Err(FixtureError::Mismatch {
                    what: format!("layer {f} (source {l})"),
                    detail: format!("{stem} is {:?}, the source layer's {:?}", a.ty, b.ty),
                });
            }
        }
    }
    for global in [
        token_embd(),
        output_norm(),
        output(),
        OUTPUT_RES_SCORE.to_string(),
    ] {
        let (Some((_, a)), Some((_, b))) = (fixture.find(&global), source.find(&global)) else {
            return Err(FixtureError::Mismatch {
                what: global,
                detail: "is missing from the fixture or the source".into(),
            });
        };
        if a.ty != b.ty {
            return Err(FixtureError::Mismatch {
                what: global,
                detail: format!("is {:?}, the source's {:?}", a.ty, b.ty),
            });
        }
    }
    Ok(fx)
}

#[cfg(test)]
mod tests {
    use super::{
        BIAS_HALF_WIDTH, BLOCK, DENSE_FF, EXPERTS, FF, HEADS, HIDDEN, LATENT, Q_LORA,
        SCORE_HALF_WIDTH, USED, const_value, key_rule, spread_value,
    };
    use crate::fixture::KeyRule;

    /// The checked-in header table of the real file's first shard (`tests/kimi_k3_hdr.kv.json`).
    const KV: &str = include_str!("../../../tests/kimi_k3_hdr.kv.json");

    /// Every `kimi-k3.*` key of the real header is covered, the nine the mini resizes are the
    /// mini's values and the per-layer head counts follow the map. Mutant: a rule removed (say
    /// `expert_latent_length`) leaves the plan's `UncoveredKey` refusal to fire on the source's own
    /// key.
    #[test]
    fn every_source_key_is_covered() {
        let header: serde_json::Value = serde_json::from_str(KV).expect("the header table parses");
        let mut keys = 0;
        for key in header.as_object().expect("an object").keys() {
            let Some(suffix) = key.strip_prefix("kimi-k3.") else {
                continue;
            };
            keys += 1;
            assert!(key_rule(suffix).is_some(), "{suffix} is uncovered");
        }
        assert_eq!(keys, 32, "the real shard's architecture keys");
        for (key, want) in [
            ("embedding_length", HIDDEN),
            ("feed_forward_length", DENSE_FF),
            ("attention.head_count", HEADS),
            ("expert_count", EXPERTS),
            ("expert_used_count", USED),
            ("expert_feed_forward_length", FF),
            ("expert_latent_length", LATENT),
            ("attention.q_lora_rank", Q_LORA),
            ("attn_res.block_size", BLOCK),
        ] {
            assert_eq!(key_rule(key), Some(KeyRule::Set(want)), "{key}");
        }
        assert_eq!(key_rule("attention.head_count_kv"), Some(KeyRule::PerLayer));
        assert_eq!(key_rule("block_count"), Some(KeyRule::BlockCount));
        for key in [
            "kda.head_dim",
            "expert_shared_count",
            "attention.kv_lora_rank",
        ] {
            assert_eq!(key_rule(key), Some(KeyRule::Copy), "{key}");
        }
        for key in ["ssm.group_count", "nextn_predict_layers"] {
            assert_eq!(
                key_rule(key),
                None,
                "{key} would change with the head count"
            );
        }
    }

    /// The fills: the norm gains 1, the decay's two constants non-unit, the selection bias and the
    /// three residual scores spreads, no leaf both, and the router's matrix no fill at all (it
    /// stays the generator's random matrix).
    #[test]
    fn the_one_dimensional_fills() {
        for leaf in [
            "attn_norm.weight",
            "ffn_norm.weight",
            "attn_q_a_norm.weight",
            "attn_kv_a_norm.weight",
            "ssm_norm.weight",
            "ffn_routed_norm.weight",
            "output_norm.weight",
        ] {
            assert_eq!(const_value(leaf), Some(1.0), "{leaf}");
        }
        assert_eq!(const_value("ssm_a"), Some(-5.0));
        assert_eq!(const_value("ssm_dt.bias"), Some(-1.0));
        for (leaf, want) in [
            ("exp_probs_b.bias", BIAS_HALF_WIDTH),
            ("attn_res_score.weight", SCORE_HALF_WIDTH),
            ("ffn_res_score.weight", SCORE_HALF_WIDTH),
            ("output_res_score.weight", SCORE_HALF_WIDTH),
        ] {
            assert_eq!(spread_value(leaf), Some(want), "{leaf}");
            assert!(
                const_value(leaf).is_none(),
                "{leaf} is both a fill and a spread"
            );
        }
        for leaf in ["ffn_gate_inp.weight", "ssm_beta.weight"] {
            assert!(
                const_value(leaf).is_none() && spread_value(leaf).is_none(),
                "{leaf} stays a matrix"
            );
        }
    }
}
