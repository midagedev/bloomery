# ink2pass (gate_inkling2_mix, the placed prompt pass): a visit's routed sum drops the host's
# share when the card holds some of the layer's experts (the card's sum only reaches the stream).
# Expected red (a table that routes a slot to the host; the Card table is unmoved):
#   mix_pass_forced_host_picks_are_the_whole_card_pass FAIL
#   mix_pass_forced_any_picks_are_the_whole_card_pass FAIL
#   mix_pass_forced_host_picks_are_the_placed_steps FAIL
#   mix_pass_forced_any_picks_are_the_placed_steps FAIL
#   mix_pass_forced_card_picks_are_the_whole_card_pass expected unmoved (no host slot: the host sum is 0)
--- a/crates/gpu/src/arch/inkling2/pass.rs
+++ b/crates/gpu/src/arch/inkling2/pass.rs
@@ -1730,7 +1730,7 @@
         let stream = gpu.stream();
         let Bufs { moe, ffn_out, .. } = &mut *self.b;
         if on_card {
-            gpu.elem().enqueue_add(stream, &*ffn_out, hsum, len, moe)
+            copy_span(stream, (&*ffn_out, 0), (moe, 0), len)
         } else {
             copy_span(stream, (hsum, 0), (moe, 0), len)
         }
