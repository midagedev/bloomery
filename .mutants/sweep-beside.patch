+++ b/tools/sweep.sh
@@ -120,7 +120,7 @@
       skipped=$((skipped + 1))
       continue
     fi
-    if [ "$(dirname "$paths")" = "$parent" ] && case $name in "$mb"-?*) true ;; *) false ;; esac; then
